<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Agent Preview Evaluation</title>
	</head>
	<body>
		<main>
			<section class="hero">
				<p class="eyebrow">Worker Preview agent eval</p>
				<h1>Catalog checkout is ready for review</h1>
				<p class="lede">
					This project is intentionally small so an agent can inspect the Preview
					comment, correlate Browser Run evidence with Worker runtime signals, and
					make a focused repair.
				</p>
			</section>

			<section class="panel" aria-label="Runtime status">
				<div>
					<p class="label">Catalog sync</p>
					<p class="status bad">Failed</p>
				</div>
				<div>
					<p class="label">Checkout quote</p>
					<p class="status good">Ready</p>
				</div>
				<div>
					<p class="label">Agent task</p>
					<p class="status neutral">Use PR evidence</p>
				</div>
			</section>
		</main>
	</body>
</html>

<style>
	:root {
		color-scheme: dark;
		font-family:
			Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
			"Segoe UI", sans-serif;
		background: #080b12;
		color: #f5f7fb;
	}

	body {
		min-height: 100vh;
		margin: 0;
		background:
			radial-gradient(circle at 15% 15%, rgba(51, 214, 159, 0.2), transparent 28rem),
			linear-gradient(135deg, #080b12, #111728 65%, #19213a);
	}

	main {
		box-sizing: border-box;
		width: min(960px, 100%);
		min-height: 100vh;
		margin: 0 auto;
		padding: 96px 24px;
	}

	.hero {
		padding: 40px;
		border: 1px solid rgba(255, 255, 255, 0.14);
		border-radius: 28px;
		background: rgba(8, 11, 18, 0.7);
		box-shadow: 0 30px 120px rgba(0, 0, 0, 0.35);
	}

	.eyebrow,
	.label {
		margin: 0;
		color: #9aa7bd;
		font-size: 0.78rem;
		font-weight: 800;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	h1 {
		max-width: 780px;
		margin: 12px 0 0;
		font-size: clamp(2.4rem, 8vw, 5.4rem);
		line-height: 0.95;
		letter-spacing: -0.07em;
	}

	.lede {
		max-width: 680px;
		margin: 24px 0 0;
		color: #c4ccda;
		font-size: clamp(1rem, 2vw, 1.2rem);
		line-height: 1.7;
	}

	.panel {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 16px;
		margin-top: 18px;
	}

	.panel > div {
		padding: 24px;
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: 20px;
		background: rgba(255, 255, 255, 0.06);
	}

	.status {
		margin: 10px 0 0;
		font-size: 1.35rem;
		font-weight: 850;
	}

	.good {
		color: #4ade80;
	}

	.bad {
		color: #fb7185;
	}

	.neutral {
		color: #93c5fd;
	}

	@media (max-width: 720px) {
		main {
			padding: 32px 16px;
		}

		.hero {
			padding: 28px;
		}

		.panel {
			grid-template-columns: 1fr;
		}
	}
</style>
